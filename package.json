{
  "name": "fga-research-extract",
  "version": "0.1.0-research.1",
  "description": "Research extraction for evidence and claim boundary inspection; distributed as GitHub source and release assets.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./schemas": "./src/schemas.mjs",
    "./manifest": "./publication-review.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "examples": "node examples/run.mjs",
    "check:public-files": "node scripts/check-public-files.mjs",
    "check:public-imports": "node scripts/check-public-imports.mjs",
    "check:public-claims": "node scripts/check-public-claims.mjs",
    "check:public-examples": "node scripts/check-public-examples.mjs",
    "check:public-package": "node scripts/check-public-package.mjs"
  },
  "files": [
    "README.md",
    "docs/architecture.md",
    "docs/authorship.md",
    "docs/claims-and-limits.md",
    "docs/negative-results.md",
    "docs/reproduction.md",
    "examples/expected-output.json",
    "examples/fixtures.mjs",
    "examples/run.mjs",
    "examples/summary.json",
    "provenance/payload-sha256.json",
    "provenance/public-files.json",
    "provenance/public-source-manifest.json",
    "publication-review.json",
    "schemas/delivery-decision-v1.schema.json",
    "schemas/transition-contract-projection-v2.schema.json",
    "schemas/verification-identity-input-v1.schema.json",
    "schemas/verification-identity-v1.schema.json",
    "scripts/check-public-claims.mjs",
    "scripts/check-public-examples.mjs",
    "scripts/check-public-files.mjs",
    "scripts/check-public-imports.mjs",
    "scripts/check-public-package.mjs",
    "src/index.mjs",
    "src/lib/assertion-v2.mjs",
    "src/lib/delivery-decision.mjs",
    "src/lib/edge-schema.mjs",
    "src/lib/finding-grounding.mjs",
    "src/lib/governed-receipt-core.mjs",
    "src/lib/verification-identity.mjs",
    "src/schemas.mjs",
    "test/checkers.test.mjs",
    "test/extraction-regressions.test.mjs",
    "test/research.test.mjs"
  ]
}
